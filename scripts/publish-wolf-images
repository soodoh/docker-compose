#!/usr/bin/env bash
set -euo pipefail
umask 077

manifest=
output=
while (($#)); do
  case "$1" in
    --manifest) manifest=${2:?}; shift 2 ;;
    --output) output=${2:?}; shift 2 ;;
    *) exit 64 ;;
  esac
done

[[ ${WOLF_IMAGE_PUBLICATION_CONFIRMED:-} == publish-reviewed-wolf-images-to-ghcr ]]
: "${GHCR_USERNAME:?GHCR_USERNAME is required}"
: "${GHCR_TOKEN:?GHCR_TOKEN is required}"
[[ -f $manifest && -n $output ]]
for command in docker jq; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done

jq -e '
  .schema == 1 and
  (.images | type == "array" and length > 0) and
  all(.images[];
    (.name | test("^[a-z0-9][a-z0-9-]+$")) and
    (.source_image_id | test("^sha256:[0-9a-f]{64}$")) and
    (.repository | test("^ghcr\\.io/[a-z0-9-]+/home-lab/wolf-[a-z0-9-]+$")) and
    (.tag | test("^image-[0-9a-f]{64}$")) and
    .tag == ("image-" + (.source_image_id | sub("^sha256:"; ""))))
  )
' "$manifest" >/dev/null

printf '%s' "$GHCR_TOKEN" | docker login ghcr.io --username "$GHCR_USERNAME" --password-stdin >/dev/null
workspace=$(mktemp -d)
cleanup() {
  while IFS= read -r reference; do
    [[ -z $reference ]] || docker image rm "$reference" >/dev/null 2>&1 || true
  done <"$workspace/tags"
  rm -rf "$workspace"
}
trap cleanup EXIT INT TERM
: >"$workspace/tags"
: >"$workspace/records.ndjson"

while IFS=$'\t' read -r name source repository tag; do
  docker image inspect "$source" >/dev/null
  reference="$repository:$tag"
  printf '%s\n' "$reference" >>"$workspace/tags"
  docker image tag "$source" "$reference"
  docker image push "$reference" >/dev/null
  digest=$(docker image inspect "$reference" \
    | jq -er --arg repository "$repository" \
      '.[0].RepoDigests | map(select(startswith($repository + "@sha256:"))) | first')
  docker manifest inspect "$digest" >/dev/null
  jq -cn --arg name "$name" --arg source_image_id "$source" --arg digest "$digest" \
    '{name: $name, source_image_id: $source_image_id, digest: $digest}' \
    >>"$workspace/records.ndjson"
done < <(jq -r '.images[] | [.name, .source_image_id, .repository, .tag] | @tsv' "$manifest")

mkdir -p "$(dirname "$output")"
jq -s '{schema: 1, images: sort_by(.name)}' "$workspace/records.ndjson" >"$workspace/output.json"
chmod 0600 "$workspace/output.json"
mv "$workspace/output.json" "$output"
echo "wolf_image_publication=verified images=$(jq '.images | length' "$output")"
