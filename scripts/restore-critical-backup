#!/usr/bin/env bash
set -euo pipefail
umask 077

backup_id=
confirmed_empty=false
while (($#)); do
  case "$1" in
    --backup-id)
      (($# >= 2)) || exit 64
      backup_id=$2
      shift 2
      ;;
    --confirmed-empty-target)
      confirmed_empty=true
      shift
      ;;
    *) exit 64 ;;
  esac
done

[[ $backup_id =~ ^(daily-remote-backup|weekly-backup)-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}\.tar\.gz\.gpg$ ]]
[[ $confirmed_empty == true ]]
: "${RECOVERY_BACKUP_URL:?RECOVERY_BACKUP_URL is required}"
: "${RECOVERY_TARGET:?RECOVERY_TARGET is required}"
: "${RECOVERY_GPG_KEY_FILE:?RECOVERY_GPG_KEY_FILE is required}"
: "${RECOVERY_BACKUP_VERSION_ID:?RECOVERY_BACKUP_VERSION_ID is required}"
: "${RECOVERY_BACKUP_SHA256:?RECOVERY_BACKUP_SHA256 is required}"
[[ $RECOVERY_BACKUP_VERSION_ID =~ ^[A-Za-z0-9._~+-]{1,1024}$ ]]
[[ $RECOVERY_BACKUP_SHA256 =~ ^[0-9a-f]{64}$ ]]
[[ $RECOVERY_BACKUP_URL == https://* ]]
[[ -d $RECOVERY_TARGET ]]
[[ -r $RECOVERY_GPG_KEY_FILE ]]
[[ -x /usr/local/libexec/home-lab-restore-critical-archive.py ]]
[[ -z $(find "$RECOVERY_TARGET" -mindepth 1 -maxdepth 1 -print -quit) ]]

url_path=${RECOVERY_BACKUP_URL%%\?*}
url_name=${url_path##*/}
[[ $url_name == "$backup_id" ]]
RECOVERY_URL="$RECOVERY_BACKUP_URL" RECOVERY_VERSION="$RECOVERY_BACKUP_VERSION_ID" python3 - <<'PY'
import os
from urllib.parse import parse_qs, urlsplit

versions = parse_qs(urlsplit(os.environ["RECOVERY_URL"]).query).get("versionId", [])
if versions != [os.environ["RECOVERY_VERSION"]]:
    raise SystemExit("signed backup URL is not bound to the approved object version")
PY

workspace=$(mktemp -d)
cleanup() {
  rm -rf "$workspace"
}
trap cleanup EXIT INT TERM
chmod 0700 "$workspace"
export GNUPGHOME="$workspace/gnupg"
install -d -m 0700 "$GNUPGHOME"

gpg --batch --quiet --import "$RECOVERY_GPG_KEY_FILE" >/dev/null 2>&1
curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  "$RECOVERY_BACKUP_URL" --output "$workspace/$backup_id"
printf '%s  %s\n' "$RECOVERY_BACKUP_SHA256" "$workspace/$backup_id" \
  | sha256sum --check --status

decrypt_args=(--batch --yes --quiet --decrypt --output "$workspace/critical.tar.gz")
if [[ -n ${RECOVERY_GPG_PASSPHRASE_FILE:-} ]]; then
  [[ -r $RECOVERY_GPG_PASSPHRASE_FILE ]]
  decrypt_args+=(--pinentry-mode loopback --passphrase-file "$RECOVERY_GPG_PASSPHRASE_FILE")
fi
gpg "${decrypt_args[@]}" "$workspace/$backup_id"
rm -f -- "$workspace/$backup_id"
/usr/local/libexec/home-lab-restore-critical-archive.py \
  --archive "$workspace/critical.tar.gz" \
  --target "$RECOVERY_TARGET"
