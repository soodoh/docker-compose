#!/usr/bin/env bash
set -euo pipefail
umask 077

[[ ${TAILSCALE_BOOTSTRAP_CONFIRMED:-} == apply-reviewed-tailscale-bootstrap ]]
: "${TF_BACKEND_BUCKET:?TF_BACKEND_BUCKET is required}"
aws_region=${AWS_REGION:-${TF_VAR_aws_region:-}}
: "${aws_region:?AWS_REGION or TF_VAR_aws_region is required}"
credential_file=${TAILSCALE_BOOTSTRAP_CREDENTIAL_FILE:-.local/tailscale/bootstrap.env}

for command in aws curl gh git jq node tofu; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done
[[ -z $(git status --porcelain --untracked-files=all) ]]
[[ -f $credential_file ]]
if stat -f '%Lp' "$credential_file" >/dev/null 2>&1; then
  [[ $(stat -f '%Lp' "$credential_file") == 600 ]]
  [[ $(stat -f '%Su' "$credential_file") == "$(id -un)" ]]
else
  [[ $(stat -c '%a' "$credential_file") == 600 ]]
  [[ $(stat -c '%U' "$credential_file") == "$(id -un)" ]]
fi

set -a
# shellcheck disable=SC1090
source "$credential_file"
set +a
: "${TAILSCALE_OAUTH_CLIENT_ID:?missing Tailscale OAuth client ID}"
: "${TAILSCALE_OAUTH_CLIENT_SECRET:?missing Tailscale OAuth client secret}"
: "${TAILSCALE_TAILNET:?missing Tailscale tailnet selector}"

export TF_VAR_tailscale_enable_management=true
export TF_VAR_ci_plan_identity_import_id=${TF_VAR_ci_plan_identity_import_id:-$(gh variable get TS_OAUTH_CLIENT_ID --env infrastructure-plan)}
export TF_VAR_ci_apply_identity_import_id=${TF_VAR_ci_apply_identity_import_id:-$(gh variable get TS_OAUTH_CLIENT_ID --env infrastructure-apply)}
[[ -n $TF_VAR_ci_plan_identity_import_id && -n $TF_VAR_ci_apply_identity_import_id ]]
[[ $TF_VAR_ci_plan_identity_import_id != "$TF_VAR_ci_apply_identity_import_id" ]]

root=infrastructure/tofu/tailscale
workspace=.local/tailscale/adoption
resume=false
if [[ -e $workspace ]]; then
  [[ ${TAILSCALE_BOOTSTRAP_RESUME_CONFIRMED:-} == resume-reviewed-partial-tailscale-bootstrap ]]
  workspace=.local/tailscale/adoption-resume
  [[ ! -e $workspace ]]
  resume=true
fi
install -d -m 0700 "$workspace"

contract_value() {
  local expression=$1
  EXPRESSION="$expression" node --input-type=module - <<'NODE'
import fs from "node:fs";
import yaml from "js-yaml";
const document = yaml.load(fs.readFileSync("infrastructure/contract/home-lab.yml", "utf8"));
let value = document;
for (const segment of process.env.EXPRESSION.split(".")) value = value?.[segment];
if (value === null || value === undefined || value === "") process.exit(1);
process.stdout.write(String(value));
NODE
}

github_owner=$(contract_value github.owner)
github_repository=$(contract_value github.repository)
export TF_VAR_github_owner_id=${TF_VAR_github_owner_id:-$(gh api "users/$github_owner" --jq .id)}
export TF_VAR_github_repository_id=${TF_VAR_github_repository_id:-$(gh api "repos/$github_owner/$github_repository" --jq .id)}
[[ $TF_VAR_github_owner_id =~ ^[0-9]+$ && $TF_VAR_github_repository_id =~ ^[0-9]+$ ]]

sha256_file() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

tailscale_access_token() {
  local response
  response=$(curl --fail --silent --show-error \
    -d "client_id=$TAILSCALE_OAUTH_CLIENT_ID" \
    -d "client_secret=$TAILSCALE_OAUTH_CLIENT_SECRET" \
    https://api.tailscale.com/api/v2/oauth/token)
  jq -er '.access_token' <<<"$response"
}

tailscale_policy_identity() {
  local access_token headers body canonical etag
  access_token=$(tailscale_access_token)
  headers=$(mktemp "${TMPDIR:-/tmp}/tailscale-bootstrap-headers.XXXXXX")
  body=$(mktemp "${TMPDIR:-/tmp}/tailscale-bootstrap-policy.XXXXXX")
  canonical=$(mktemp "${TMPDIR:-/tmp}/tailscale-bootstrap-canonical.XXXXXX")
  chmod 0600 "$headers" "$body" "$canonical"
  curl --fail --silent --show-error \
    -D "$headers" \
    -H "Authorization: Bearer $access_token" \
    -H 'Accept: application/json' \
    "https://api.tailscale.com/api/v2/tailnet/$TAILSCALE_TAILNET/acl" \
    -o "$body"
  jq -cS -e . "$body" >"$canonical"
  etag=$(awk 'tolower($1) == "etag:" {gsub(/\r/, ""); sub(/^[^:]+:[[:space:]]*/, ""); print; exit}' "$headers")
  [[ -n $etag ]]
  printf '%s\t%s\n' "$(sha256_file "$canonical")" "$etag"
  rm -f "$headers" "$body" "$canonical"
  unset access_token
}

tailscale_planned_policy() {
  local plan=$1 destination=$2
  tofu -chdir="$root" show -json "$plan" | jq -er '
    .resource_changes[] |
    select(.address == "terraform_data.tailscale_policy[0]") |
    .change.after.input.policy_json |
    fromjson
  ' | jq -cS . >"$destination"
}

apply_planned_policy() {
  local plan=$1 expected_sha=$2 expected_etag=$3
  local desired response desired_sha current_sha current_etag access_token after_sha after_etag
  desired=$(mktemp "${TMPDIR:-/tmp}/tailscale-bootstrap-desired.XXXXXX")
  response=$(mktemp "${TMPDIR:-/tmp}/tailscale-bootstrap-response.XXXXXX")
  chmod 0600 "$desired" "$response"
  tailscale_planned_policy "$plan" "$desired"
  desired_sha=$(sha256_file "$desired")
  IFS=$'\t' read -r current_sha current_etag < <(tailscale_policy_identity)
  if [[ $current_sha != "$desired_sha" ]]; then
    [[ $current_sha == "$expected_sha" && $current_etag == "$expected_etag" ]] || {
      echo "The live Tailscale policy changed after planning; refusing the saved plan." >&2
      rm -f "$desired" "$response"
      exit 1
    }
    access_token=$(tailscale_access_token)
    curl --fail --silent --show-error \
      -H "Authorization: Bearer $access_token" \
      -H 'Content-Type: application/json' \
      --data-binary @"$desired" \
      "https://api.tailscale.com/api/v2/tailnet/$TAILSCALE_TAILNET/acl/validate" \
      -o "$response"
    jq -e '((.errors // []) | length) == 0 and ((.warnings // []) | length) == 0' "$response" >/dev/null
    curl --fail --silent --show-error -X POST \
      -H "Authorization: Bearer $access_token" \
      -H 'Content-Type: application/json' \
      -H "If-Match: $expected_etag" \
      --data-binary @"$desired" \
      "https://api.tailscale.com/api/v2/tailnet/$TAILSCALE_TAILNET/acl" \
      -o "$response"
    unset access_token
  fi
  IFS=$'\t' read -r after_sha after_etag < <(tailscale_policy_identity)
  [[ $after_sha == "$desired_sha" && -n $after_etag ]]
  rm -f "$desired" "$response"
}

lease_table=$(contract_value aws.mutation_lease_table)
lease_owner="tailscale-bootstrap:$$:$(git rev-parse HEAD)"
lease_held=false
release_lease() {
  if [[ $lease_held == true ]]; then
    aws dynamodb delete-item \
      --region "$aws_region" \
      --table-name "$lease_table" \
      --key '{"LeaseName":{"S":"home-lab-production"}}' \
      --condition-expression '#owner = :owner' \
      --expression-attribute-names '{"#owner":"Owner"}' \
      --expression-attribute-values "{\":owner\":{\"S\":\"$lease_owner\"}}" \
      >/dev/null || echo "warning: global mutation lease release failed" >&2
  fi
}
trap release_lease EXIT

now=$(date +%s)
expires=$((now + 14400))
aws dynamodb put-item \
  --region "$aws_region" \
  --table-name "$lease_table" \
  --item "{\"LeaseName\":{\"S\":\"home-lab-production\"},\"Owner\":{\"S\":\"$lease_owner\"},\"ExpiresAt\":{\"N\":\"$expires\"}}" \
  --condition-expression 'attribute_not_exists(LeaseName) OR #expires < :now' \
  --expression-attribute-names '{"#expires":"ExpiresAt"}' \
  --expression-attribute-values "{\":now\":{\"N\":\"$now\"}}" \
  >/dev/null
lease_held=true

IFS=$'\t' read -r planned_policy_sha planned_policy_etag < <(tailscale_policy_identity)
printf '%s\n' "$planned_policy_sha" >"$workspace/planned-policy.sha256"
printf '%s\n' "$planned_policy_etag" >"$workspace/planned-policy.etag"

tofu -chdir="$root" init -input=false -reconfigure \
  -backend-config="bucket=$TF_BACKEND_BUCKET" \
  -backend-config="region=$aws_region" \
  -backend-config="encrypt=true" \
  -backend-config="use_lockfile=true" >/dev/null

rc=0
tofu -chdir="$root" plan -input=false -lock-timeout=5m -parallelism=1 \
  -detailed-exitcode -out="$PWD/$workspace/tailscale.tfplan" || rc=$?
[[ $rc == 2 || ( $resume == true && $rc == 0 ) ]]
tofu -chdir="$root" show -json "$PWD/$workspace/tailscale.tfplan" >"$workspace/tailscale-plan.json"

jq -e --argjson resume "$resume" '
  [
    "tailscale_federated_identity.ci_apply[0]",
    "tailscale_federated_identity.ci_plan[0]",
    "tailscale_federated_identity.provider_apply[0]",
    "tailscale_federated_identity.provider_plan[0]",
    "terraform_data.tailscale_policy[0]"
  ] as $expected |
  [.resource_changes[]? |
    select(.mode == "managed") |
    select((.change.actions != ["no-op"]) or (.change.importing != null))
  ] as $changes |
  if $resume then
    (([$changes[].address] - $expected) | length == 0) and
    ($changes | all(.change.importing == null and .change.actions == ["update"]))
  else
    ([$changes[].address] | sort) == ($expected | sort) and
    ($changes | all(.change.actions | index("delete") == null)) and
    ($changes | map(select(.address == "terraform_data.tailscale_policy[0]")) | all(
      .change.importing == null and .change.before == null and .change.actions == ["create"]
    )) and
    ($changes | map(select(.address == "tailscale_federated_identity.ci_plan[0]" or .address == "tailscale_federated_identity.ci_apply[0]")) | all(
      .change.importing != null and (.change.actions == ["no-op"] or .change.actions == ["update"])
    )) and
    ($changes | map(select(.address == "tailscale_federated_identity.provider_plan[0]" or .address == "tailscale_federated_identity.provider_apply[0]")) | all(
      .change.importing == null and .change.before == null and .change.actions == ["create"]
    ))
  end
' "$workspace/tailscale-plan.json" >/dev/null

PLAN_FILE="$workspace/tailscale.tfplan" SECRET_VALUE="$TAILSCALE_OAUTH_CLIENT_SECRET" python3 - <<'PY'
import os
from pathlib import Path
if os.environ["SECRET_VALUE"].encode() in Path(os.environ["PLAN_FILE"]).read_bytes():
    raise SystemExit("saved plan contains the Tailscale bootstrap credential")
PY
rm -f "$workspace/tailscale-plan.json"

if [[ $rc == 2 ]]; then
  apply_planned_policy "$PWD/$workspace/tailscale.tfplan" "$planned_policy_sha" "$planned_policy_etag"
  tofu -chdir="$root" apply -input=false -lock-timeout=5m -parallelism=1 \
    "$PWD/$workspace/tailscale.tfplan"
fi

rc=0
tofu -chdir="$root" plan -input=false -lock-timeout=5m -parallelism=1 -detailed-exitcode || rc=$?
[[ $rc == 0 ]]

tofu -chdir="$root" state pull | jq -er '
  .values.root_module.resources[] |
  select(.address == "terraform_data.tailscale_policy[0]") |
  .values.input.policy_json | fromjson
' | jq -cS . >"$workspace/state-policy.json"
access_token=$(tailscale_access_token)
curl --fail --silent --show-error \
  -H "Authorization: Bearer $access_token" \
  -H 'Accept: application/json' \
  "https://api.tailscale.com/api/v2/tailnet/$TAILSCALE_TAILNET/acl" |
  jq -cS . >"$workspace/live-policy.json"
unset access_token
cmp -s "$workspace/state-policy.json" "$workspace/live-policy.json"

outputs=$(tofu -chdir="$root" output -json)
plan_client_id=$(jq -er '.ci_plan_client_id.value' <<<"$outputs")
plan_audience=$(jq -er '.ci_plan_audience.value' <<<"$outputs")
apply_client_id=$(jq -er '.ci_apply_client_id.value' <<<"$outputs")
apply_audience=$(jq -er '.ci_apply_audience.value' <<<"$outputs")
provider_plan_client_id=$(jq -er '.provider_plan_client_id.value' <<<"$outputs")
provider_plan_audience=$(jq -er '.provider_plan_audience.value' <<<"$outputs")
provider_apply_client_id=$(jq -er '.provider_apply_client_id.value' <<<"$outputs")
provider_apply_audience=$(jq -er '.provider_apply_audience.value' <<<"$outputs")

gh variable set TS_OAUTH_CLIENT_ID --env infrastructure-plan --body "$plan_client_id"
gh variable set TS_AUDIENCE --env infrastructure-plan --body "$plan_audience"
gh variable set TS_PROVIDER_PLAN_CLIENT_ID --env infrastructure-plan --body "$provider_plan_client_id"
gh variable set TS_PROVIDER_PLAN_AUDIENCE --env infrastructure-plan --body "$provider_plan_audience"
gh variable set TS_OAUTH_CLIENT_ID --env infrastructure-apply --body "$apply_client_id"
gh variable set TS_AUDIENCE --env infrastructure-apply --body "$apply_audience"
gh variable set TS_PROVIDER_APPLY_CLIENT_ID --env infrastructure-apply --body "$provider_apply_client_id"
gh variable set TS_PROVIDER_APPLY_AUDIENCE --env infrastructure-apply --body "$provider_apply_audience"
for environment in infrastructure-plan infrastructure-apply; do
  gh variable set TAILSCALE_SUBJECT_OWNER_ID --env "$environment" --body "$TF_VAR_github_owner_id"
  gh variable set TAILSCALE_SUBJECT_REPOSITORY_ID --env "$environment" --body "$TF_VAR_github_repository_id"
done

echo "tailscale_bootstrap=applied_noop_and_environment_variables_staged retained_evidence=$workspace"
