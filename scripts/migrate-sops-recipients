#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

recovery_recipient=age1vvzm5pczjum52v5alall8euucjen9q4v9xa5g0xmswhna5vare9qwv9rq6
ci_recipient=${CI_AGE_RECIPIENT:-}
[[ $ci_recipient =~ ^age1[023456789acdefghjklmnpqrstuvwxyz]{58}$ ]] || {
  echo "CI_AGE_RECIPIENT must be the approved public age recipient." >&2
  exit 64
}
[[ $ci_recipient != "$recovery_recipient" ]] || {
  echo "CI and recovery recipients must differ." >&2
  exit 64
}
for command in sops python3; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done

workspace=$(mktemp -d)
success=false
cleanup() {
  if [[ $success != true ]]; then
    cp "$workspace/production.sops.env" secrets/production.sops.env
    cp "$workspace/sops.yaml" .sops.yaml
  fi
  rm -rf "$workspace"
}
trap cleanup EXIT INT TERM

cp secrets/production.sops.env "$workspace/production.sops.env"
cp .sops.yaml "$workspace/sops.yaml"
cat >"$workspace/new-sops.yaml" <<EOF
creation_rules:
  - path_regex: ^secrets/production\\.sops\\.env$
    age: $recovery_recipient,$ci_recipient
EOF

sops decrypt secrets/production.sops.env >/dev/null
sops updatekeys --yes --config "$workspace/new-sops.yaml" secrets/production.sops.env
install -m 0644 "$workspace/new-sops.yaml" .sops.yaml
python3 scripts/check-sops-env.py \
  secrets/production.sops.env \
  secrets/production.env.keys \
  secrets/production.env.layout.json \
  "$recovery_recipient" "$ci_recipient"
success=true
echo "SOPS ciphertext migrated to two public recipients."
