#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
root=infrastructure/tofu/proxmox-lxc-qualification
helper=.github/scripts/proxmox-lxc-qualification.py
bundle_dir=${LXC_QUALIFICATION_PLAN_DIR:-$repo_root/.reconcile/lxc-qualification}
plan_file=$bundle_dir/qualification.tfplan
manifest=$bundle_dir/manifest.json
backend_key=home-lab/proxmox-lxc-qualification/tofu.tfstate

usage() {
  echo "usage: scripts/qualify-proxmox-lxc <plan|apply> <create|probe-protected-delete|verify-protected|unprotect|reprotect|delete|verify-empty>" >&2
  echo "       scripts/qualify-proxmox-lxc <inspect-recovery|recover-lock>" >&2
  exit 64
}

if (($# == 1)) && [[ $1 == inspect-recovery || $1 == recover-lock ]]; then
  action=$1
  operation=verify-protected
elif (($# == 2)); then
  action=$1
  operation=$2
  case "$action" in plan|apply) ;; *) usage ;; esac
  case "$operation" in
    create|probe-protected-delete|verify-protected|unprotect|reprotect|delete|verify-empty) ;;
    *) usage ;;
  esac
else
  usage
fi

for command in tofu python3 aws git; do
  command -v "$command" >/dev/null || {
    echo "required qualification command is unavailable: $command" >&2
    exit 69
  }
done
if [[ $action == apply || $action == recover-lock ]]; then
  command -v node >/dev/null || {
    echo "required qualification command is unavailable: node" >&2
    exit 69
  }
fi
: "${TF_BACKEND_BUCKET:?TF_BACKEND_BUCKET is required}"
: "${AWS_REGION:?AWS_REGION is required}"
: "${TF_VAR_proxmox_endpoint:?TF_VAR_proxmox_endpoint is required}"
: "${TF_VAR_qualification_vm_id:?protected qualification VMID is required}"
: "${TF_VAR_qualification_template_file_id:?protected qualification template file ID is required}"
: "${PROXMOX_PLAN_API_TOKEN:?separate Proxmox plan API token is required}"
: "${PROXMOX_CA_PEM:?protected Proxmox CA certificate is required}"
if [[ $action == apply || $action == recover-lock ]]; then
  : "${PROXMOX_APPLY_API_TOKEN:?separate Proxmox apply API token is required}"
  [[ $PROXMOX_PLAN_API_TOKEN != "$PROXMOX_APPLY_API_TOKEN" ]] || {
    echo "plan and apply Proxmox credentials must be distinct" >&2
    exit 64
  }
fi
if [[ $action == recover-lock ]]; then
  command -v gh >/dev/null || {
    echo "required qualification command is unavailable: gh" >&2
    exit 69
  }
  : "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required for reviewed recovery}"
  : "${PROXMOX_LXC_QUALIFICATION_RECOVERY_RUN_ID:?protected recovery run ID is required}"
  : "${PROXMOX_LXC_QUALIFICATION_RECOVERY_LOCK_SHA256:?protected recovery lock SHA-256 is required}"
  [[ $PROXMOX_LXC_QUALIFICATION_RECOVERY_RUN_ID =~ ^[0-9]+$ ]] || {
    echo "protected recovery run ID is invalid" >&2
    exit 64
  }
  [[ $PROXMOX_LXC_QUALIFICATION_RECOVERY_LOCK_SHA256 =~ ^[0-9a-f]{64}$ ]] || {
    echo "protected recovery lock SHA-256 is invalid" >&2
    exit 64
  }
fi
export TF_IN_AUTOMATION=1 TF_INPUT=0 TF_VAR_qualification_operation=$operation
commit=$(git rev-parse HEAD)
if [[ $action == apply || $action == inspect-recovery || $action == recover-lock ]]; then
  if [[ ${GITHUB_ACTIONS:-false} == true ]]; then
    [[ ${GITHUB_REF:-} == refs/heads/main && ${GITHUB_SHA:-} == "$commit" ]] || {
      echo "qualification operation requires the exact dispatched main commit" >&2
      exit 64
    }
  else
    [[ $(git branch --show-current) == main ]] || {
      echo "qualification operation is main-only" >&2
      exit 64
    }
    [[ $(git rev-parse origin/main) == "$commit" ]] || {
      echo "qualification operation requires the existing origin/main commit" >&2
      exit 64
    }
  fi
  [[ -z $(git status --porcelain --untracked-files=all) ]] || {
    echo "qualification operation requires a clean checkout" >&2
    exit 65
  }
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/lxc-qualification.XXXXXX")
chmod 0700 "$work"
lease_table=
lease_owner="${GITHUB_RUN_ID:-local}:lxc-qualification:$$:$commit"
lease_held=false
release_lease_on_exit=false
release_lease() {
  if [[ $lease_held == true ]]; then
    aws dynamodb delete-item \
      --region "$AWS_REGION" \
      --table-name "$lease_table" \
      --key '{"LeaseName":{"S":"home-lab-production"}}' \
      --condition-expression '#owner = :owner' \
      --expression-attribute-names '{"#owner":"Owner"}' \
      --expression-attribute-values "{\":owner\":{\"S\":\"$lease_owner\"}}" \
      >/dev/null 2>&1 || echo "warning: global mutation lease release failed" >&2
    lease_held=false
  fi
}
cleanup() {
  if [[ $release_lease_on_exit == true ]]; then
    release_lease
  elif [[ $lease_held == true ]]; then
    echo "qualification failed closed with the mutation lease retained; run inspect-recovery before any reviewed recovery plan" >&2
  fi
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

backend_init() {
  if ! tofu -chdir="$root" init -input=false -reconfigure \
    -backend-config="bucket=$TF_BACKEND_BUCKET" \
    -backend-config="region=$AWS_REGION" \
    -backend-config="encrypt=true" \
    -backend-config="use_lockfile=true" >"$work/init.log" 2>&1; then
    echo "qualification backend initialization failed" >&2
    return 1
  fi
}

pull_state() {
  local destination=$1 allow_missing=$2
  if tofu -chdir="$root" state pull >"$destination" 2>"$work/state-pull.log"; then
    chmod 0600 "$destination"
    return
  fi
  if [[ $allow_missing == true ]] && grep -Eqi 'no state file (was )?found|state snapshot was not found' "$work/state-pull.log"; then
    printf '{"resources":[]}\n' >"$destination"
    chmod 0600 "$destination"
    return
  fi
  echo "qualification state could not be read conclusively" >&2
  exit 1
}

pull_state_recovery() {
  local destination=$1
  if tofu -chdir="$root" state pull >"$destination" 2>"$work/state-pull.log"; then
    chmod 0600 "$destination"
    return 0
  fi
  if grep -Eqi 'no state file (was )?found|state snapshot was not found' "$work/state-pull.log"; then
    printf '{"resources":[]}\n' >"$destination"
    chmod 0600 "$destination"
    return 0
  fi
  return 1
}

state_mode_for_operation() {
  case "$operation" in
    create|verify-empty) echo empty ;;
    probe-protected-delete|verify-protected|unprotect) echo protected ;;
    reprotect|delete) echo unprotected ;;
  esac
}

api_mode_for_operation() {
  case "$operation" in
    create) echo pre-create ;;
    probe-protected-delete|verify-protected|unprotect) echo protected ;;
    reprotect|delete) echo unprotected ;;
    verify-empty) echo absent ;;
  esac
}

preflight() {
  local state_mode api_mode allow_missing=false
  state_mode=$(state_mode_for_operation)
  api_mode=$(api_mode_for_operation)
  [[ $operation == create ]] && allow_missing=true
  if [[ $action == apply ]]; then
    export PROXMOX_VE_API_TOKEN=$PROXMOX_APPLY_API_TOKEN
    export PROXMOX_VERIFY_STORAGE_VOLUME=true
  else
    export PROXMOX_VE_API_TOKEN=$PROXMOX_PLAN_API_TOKEN
  fi
  python3 "$helper" api-check --mode "$api_mode"
  pull_state "$work/state.json" "$allow_missing"
  python3 "$helper" validate-state --state-json "$work/state.json" --mode "$state_mode"
  unset PROXMOX_VE_API_TOKEN PROXMOX_VERIFY_STORAGE_VOLUME || true
}

inspect_saved_plan() {
  local source=$1 mode=$2
  tofu -chdir="$root" show -json "$source" >"$work/plan.json" 2>"$work/show.log" || {
    echo "qualification saved plan could not be decoded" >&2
    exit 1
  }
  chmod 0600 "$work/plan.json"
  python3 "$helper" inspect-plan --plan-json "$work/plan.json" --mode "$mode"
}

assert_plan_excludes_credentials() {
  local credential
  for credential in "$PROXMOX_PLAN_API_TOKEN" "${PROXMOX_APPLY_API_TOKEN:-}"; do
    [[ -n $credential ]] || continue
    PLAN_FILE=$plan_file SECRET_VALUE=$credential python3 - <<'PY'
import os
from pathlib import Path
if os.environ["SECRET_VALUE"].encode() in Path(os.environ["PLAN_FILE"]).read_bytes():
    raise SystemExit("saved qualification plan contains a provider credential")
PY
  done
}

acquire_lease() {
  local now expires
  lease_table=$(node --input-type=module - <<'NODE'
import fs from "node:fs";
import yaml from "js-yaml";
const contract = yaml.load(fs.readFileSync("infrastructure/contract/home-lab.yml", "utf8"));
process.stdout.write(contract.aws.mutation_lease_table);
NODE
)
  now=$(date +%s)
  expires=$((now + 14400))
  aws dynamodb put-item \
    --region "$AWS_REGION" \
    --table-name "$lease_table" \
    --item "{\"LeaseName\":{\"S\":\"home-lab-production\"},\"Owner\":{\"S\":\"$lease_owner\"},\"ExpiresAt\":{\"N\":\"$expires\"}}" \
    --condition-expression 'attribute_not_exists(LeaseName) OR #expires < :now' \
    --expression-attribute-names '{"#expires":"ExpiresAt"}' \
    --expression-attribute-values "{\":now\":{\"N\":\"$now\"}}" \
    >/dev/null
  lease_held=true
}

backend_lock_count() {
  aws s3api list-objects-v2 \
    --bucket "$TF_BACKEND_BUCKET" \
    --prefix "${backend_key}.tflock" \
    --query 'KeyCount' --output text 2>"$work/backend-lock.log"
}

verify_backend_lock_absent() {
  local count
  count=$(backend_lock_count) || {
    echo "qualification backend lock absence was inconclusive" >&2
    exit 1
  }
  [[ $count == 0 ]] || {
    echo "qualification backend lock remains present" >&2
    exit 1
  }
}

post_apply_proof() {
  local expected_state expected_api fresh_plan=$work/fresh.tfplan status
  case "$operation" in
    create|reprotect|verify-protected|probe-protected-delete)
      expected_state=protected
      expected_api=protected
      ;;
    unprotect)
      expected_state=unprotected
      expected_api=unprotected
      ;;
    delete|verify-empty)
      expected_state=empty
      expected_api=absent
      ;;
  esac
  export PROXMOX_VE_API_TOKEN=$PROXMOX_APPLY_API_TOKEN
  export PROXMOX_VERIFY_STORAGE_VOLUME=true
  python3 "$helper" api-check --mode "$expected_api"
  unset PROXMOX_VE_API_TOKEN PROXMOX_VERIFY_STORAGE_VOLUME
  export PROXMOX_VE_API_TOKEN=$PROXMOX_PLAN_API_TOKEN
  pull_state "$work/post-state.json" false
  python3 "$helper" validate-state --state-json "$work/post-state.json" --mode "$expected_state"
  if [[ $operation == probe-protected-delete ]]; then
    verify_backend_lock_absent
    unset PROXMOX_VE_API_TOKEN
    echo "protected-delete rejection left the exact qualification identity protected"
    return
  fi
  set +e
  tofu -chdir="$root" plan -input=false -lock-timeout=5m -parallelism=1 \
    -detailed-exitcode -out="$fresh_plan" >"$work/fresh-plan.log" 2>&1
  status=$?
  set -e
  [[ $status == 0 ]] || {
    echo "fresh qualification no-op proof failed" >&2
    exit 1
  }
  if [[ $expected_state == protected ]]; then
    inspect_saved_plan "$fresh_plan" verify-protected
  elif [[ $expected_state == empty ]]; then
    inspect_saved_plan "$fresh_plan" verify-empty
  fi
  verify_backend_lock_absent
  unset PROXMOX_VE_API_TOKEN
  echo "fresh qualification no-op and identity proof passed"
}

if [[ $action == recover-lock ]]; then
  recovery_run=$PROXMOX_LXC_QUALIFICATION_RECOVERY_RUN_ID
  recovery_failed_commit=926899dec1d5511f668339c8ef040e2cbfe0724f
  gh api "repos/$GITHUB_REPOSITORY/actions/runs/$recovery_run" >"$work/run.json"
  gh api "repos/$GITHUB_REPOSITORY/actions/runs/$recovery_run/jobs?filter=all" >"$work/jobs.json"
  gh run view "$recovery_run" --repo "$GITHUB_REPOSITORY" --log >"$work/run.log"
  lease_table=$(node --input-type=module - <<'NODE'
import fs from "node:fs";
import yaml from "js-yaml";
const contract = yaml.load(fs.readFileSync("infrastructure/contract/home-lab.yml", "utf8"));
process.stdout.write(contract.aws.mutation_lease_table);
NODE
  )
  aws s3api get-object \
    --bucket "$TF_BACKEND_BUCKET" \
    --key "${backend_key}.tflock" \
    "$work/backend-lock.json" >/dev/null
  aws dynamodb get-item \
    --region "$AWS_REGION" \
    --table-name "$lease_table" \
    --key '{"LeaseName":{"S":"home-lab-production"}}' \
    --consistent-read >"$work/lease.json"
  RECOVERY_RUN=$recovery_run RECOVERY_FAILED_COMMIT=$recovery_failed_commit \
    RECOVERY_BUCKET=$TF_BACKEND_BUCKET RECOVERY_KEY=$backend_key python3 - \
    "$work/backend-lock.json" "$work/lease.json" "$work/run.json" "$work/jobs.json" \
    "$work/run.log" "$work/lock-id" "$work/lease-owner" <<'PY'
from datetime import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import uuid


def timestamp(value: object) -> datetime:
    if not isinstance(value, str):
        raise ValueError
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


lock_bytes = Path(sys.argv[1]).read_bytes()
lock = json.loads(lock_bytes)
lease = json.loads(Path(sys.argv[2]).read_text()).get("Item")
run = json.loads(Path(sys.argv[3]).read_text())
jobs = json.loads(Path(sys.argv[4]).read_text()).get("jobs")
run_log = Path(sys.argv[5]).read_text()
failed_commit = os.environ["RECOVERY_FAILED_COMMIT"]
if hashlib.sha256(lock_bytes).hexdigest() != os.environ["PROXMOX_LXC_QUALIFICATION_RECOVERY_LOCK_SHA256"]:
    raise SystemExit("stale backend lock does not match the reviewed incident fingerprint")
if (
    str(run.get("id")) != os.environ["RECOVERY_RUN"]
    or run.get("status") != "completed"
    or run.get("conclusion") != "failure"
    or run.get("head_sha") != failed_commit
    or run.get("event") != "workflow_dispatch"
    or run.get("path") != ".github/workflows/proxmox-lxc-qualification.yml"
):
    raise SystemExit("protected recovery run is not the exact completed failed qualification run")
if not isinstance(jobs, list):
    raise SystemExit("protected recovery job evidence is malformed")
job_name = "Apply exact qualification plan and prove identity"
apply_jobs = [job for job in jobs if isinstance(job, dict) and job.get("name") == job_name]
if len(apply_jobs) != 1:
    raise SystemExit("protected recovery apply job is not exact")
apply_job = apply_jobs[0]
failed_steps = [
    step for step in apply_job.get("steps", [])
    if isinstance(step, dict) and step.get("name") == "Apply one exact operation and prove the postcondition"
]
if (
    str(apply_job.get("run_id")) != os.environ["RECOVERY_RUN"]
    or apply_job.get("conclusion") != "failure"
    or len(failed_steps) != 1
    or failed_steps[0].get("conclusion") != "failure"
):
    raise SystemExit("protected recovery failed step is not exact")
step_name = "Apply one exact operation and prove the postcondition"
step_log = "\n".join(
    fields[2]
    for line in run_log.splitlines()
    if len(fields := line.split("\t", 2)) == 3 and fields[0] == job_name and fields[1] == step_name
)
required_log_evidence = (
    "./scripts/qualify-proxmox-lxc apply 'create'",
    "exact qualification saved plan applied",
    "live qualification inventory identity is invalid",
    "qualification failed closed with the mutation lease retained",
)
if any(evidence not in step_log for evidence in required_log_evidence):
    raise SystemExit("protected recovery step log does not prove the failed create postcondition")
required_lock = {"ID", "Operation", "Info", "Who", "Version", "Created", "Path"}
if set(lock) != required_lock:
    raise SystemExit("stale backend lock shape is not exact")
try:
    uuid.UUID(lock["ID"])
    lock_created = timestamp(lock["Created"])
    step_started = timestamp(failed_steps[0].get("started_at"))
    step_completed = timestamp(failed_steps[0].get("completed_at"))
except (AttributeError, TypeError, ValueError):
    raise SystemExit("stale backend lock identity is invalid") from None
expected_path = f'{os.environ["RECOVERY_BUCKET"]}/{os.environ["RECOVERY_KEY"]}'
if (
    lock["Operation"] != "OperationTypeApply"
    or lock["Version"] != "1.12.5"
    or lock["Info"] != ""
    or not isinstance(lock["Who"], str)
    or not re.fullmatch(r"runner@[A-Za-z0-9._-]+", lock["Who"])
    or lock["Path"] not in {expected_path, f"s3://{expected_path}"}
    or not step_started <= lock_created <= step_completed
):
    raise SystemExit("stale backend lock does not bind the exact failed apply step")
if not isinstance(lease, dict) or set(lease) != {"LeaseName", "Owner", "ExpiresAt"}:
    raise SystemExit("retained mutation lease shape is not exact")
try:
    lease_name = lease["LeaseName"]["S"]
    owner = lease["Owner"]["S"]
    expires = lease["ExpiresAt"]["N"]
except (KeyError, TypeError):
    raise SystemExit("retained mutation lease identity is invalid") from None
expected_owner = rf'{re.escape(os.environ["RECOVERY_RUN"])}:lxc-qualification:[0-9]+:{re.escape(failed_commit)}'
if lease_name != "home-lab-production" or not re.fullmatch(expected_owner, owner) or not expires.isdigit():
    raise SystemExit("retained mutation lease does not belong to the reviewed failed run")
Path(sys.argv[6]).write_text(lock["ID"] + "\n")
Path(sys.argv[7]).write_text(owner + "\n")
PY
  chmod 0600 "$work/lock-id" "$work/lease-owner"
  backend_init
  tofu -chdir="$root" force-unlock -force "$(<"$work/lock-id")" >"$work/force-unlock.log" 2>&1
  verify_backend_lock_absent
  pull_state_recovery "$work/recovery-state.json" || {
    echo "qualification state could not be read after reviewed lock recovery" >&2
    exit 1
  }
  export PROXMOX_VE_API_TOKEN=$PROXMOX_APPLY_API_TOKEN
  export PROXMOX_VERIFY_STORAGE_VOLUME=true
  classification=$(python3 "$helper" inspect-recovery --state-json "$work/recovery-state.json")
  unset PROXMOX_VE_API_TOKEN PROXMOX_VERIFY_STORAGE_VOLUME
  [[ $classification == aligned-protected ]] || {
    echo "reviewed lock recovery did not prove aligned-protected" >&2
    exit 1
  }
  lease_owner=$(<"$work/lease-owner")
  aws dynamodb delete-item \
    --region "$AWS_REGION" \
    --table-name "$lease_table" \
    --key '{"LeaseName":{"S":"home-lab-production"}}' \
    --condition-expression '#owner = :owner' \
    --expression-attribute-names '{"#owner":"Owner"}' \
    --expression-attribute-values "{\":owner\":{\"S\":\"$lease_owner\"}}" \
    >/dev/null
  aws dynamodb get-item \
    --region "$AWS_REGION" \
    --table-name "$lease_table" \
    --key '{"LeaseName":{"S":"home-lab-production"}}' \
    --consistent-read >"$work/post-lease.json"
  python3 - "$work/post-lease.json" <<'PY'
import json
from pathlib import Path
import sys
if json.loads(Path(sys.argv[1]).read_text()).get("Item"):
    raise SystemExit("reviewed mutation lease release was not proven")
PY
  echo "reviewed stale locks removed after aligned-protected proof"
  exit 0
fi

if [[ $action == inspect-recovery ]]; then
  if ! backend_init >/dev/null 2>&1; then
    echo "backend-init-failed"
    exit 1
  fi
  if ! lock_count=$(backend_lock_count); then
    echo "lock-query-failed"
    exit 1
  fi
  if [[ $lock_count == 1 ]]; then
    if ! aws s3api get-object --bucket "$TF_BACKEND_BUCKET" --key "${backend_key}.tflock" \
      "$work/inspection-lock.json" >/dev/null 2>&1; then
      echo "lock-read-failed"
      exit 1
    fi
    fingerprint=$(python3 - "$work/inspection-lock.json" <<'PY'
import hashlib
from pathlib import Path
import sys
print(hashlib.sha256(Path(sys.argv[1]).read_bytes()).hexdigest())
PY
    )
    echo "lock-present sha256=$fingerprint"
    exit 0
  elif [[ $lock_count != 0 ]]; then
    echo "lock-count-invalid"
    exit 1
  fi
  if ! pull_state_recovery "$work/recovery-state.json"; then
    echo "state-read-failed"
    exit 1
  fi
  export PROXMOX_VE_API_TOKEN=$PROXMOX_PLAN_API_TOKEN
  python3 "$helper" inspect-recovery --state-json "$work/recovery-state.json"
  unset PROXMOX_VE_API_TOKEN
  exit 0
fi

if [[ $action == apply ]]; then
  [[ -f $plan_file && -f $manifest ]] || {
    echo "qualification saved-plan bundle is incomplete" >&2
    exit 66
  }
  python3 "$helper" verify-manifest \
    --manifest "$manifest" --operation "$operation" --commit "$commit" --plan "$plan_file"
fi
backend_init
preflight

if [[ $action == plan ]]; then
  rm -rf "$bundle_dir"
  install -d -m 0700 "$bundle_dir"
  export PROXMOX_VE_API_TOKEN=$PROXMOX_PLAN_API_TOKEN
  set +e
  tofu -chdir="$root" plan -input=false -lock-timeout=5m -parallelism=1 \
    -detailed-exitcode -out="$plan_file" >"$work/plan.log" 2>&1
  plan_status=$?
  set -e
  unset PROXMOX_VE_API_TOKEN
  case "$operation" in
    verify-protected|verify-empty) expected_status=0 ;;
    *) expected_status=2 ;;
  esac
  [[ $plan_status == "$expected_status" ]] || {
    echo "qualification plan did not produce the exact expected action cardinality" >&2
    exit 1
  }
  chmod 0600 "$plan_file"
  inspect_saved_plan "$plan_file" "$operation"
  assert_plan_excludes_credentials
  python3 "$helper" create-manifest \
    --manifest "$manifest" --operation "$operation" --commit "$commit" --plan "$plan_file"
  chmod 0600 "$manifest"
  echo "encrypted-artifact-ready qualification saved plan and manifest created"
  exit 0
fi

inspect_saved_plan "$plan_file" "$operation"
acquire_lease
export PROXMOX_VE_API_TOKEN=$PROXMOX_APPLY_API_TOKEN
set +e
tofu -chdir="$root" apply -input=false -lock-timeout=5m -parallelism=1 -auto-approve \
  "$plan_file" >"$work/apply.log" 2>&1
apply_status=$?
set -e
unset PROXMOX_VE_API_TOKEN
if [[ $operation == probe-protected-delete ]]; then
  [[ $apply_status != 0 ]] || {
    echo "protected-delete probe unexpectedly succeeded" >&2
    exit 1
  }
  python3 "$helper" classify-probe-log --log "$work/apply.log"
elif [[ $apply_status != 0 ]]; then
  echo "qualification saved-plan apply failed; protected log was destroyed" >&2
  exit 1
else
  echo "exact qualification saved plan applied"
fi
post_apply_proof
release_lease_on_exit=true
