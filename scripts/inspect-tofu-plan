#!/usr/bin/env bash
set -euo pipefail

if (($# < 1)); then
  echo "usage: $0 <saved-plan> [policy arguments...]" >&2
  exit 64
fi

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
plan=$1
plan="$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")"
shift
tofu_chdir=${TOFU_PLAN_CHDIR:-}
json=$(mktemp)
trap 'rm -f "$json"' EXIT
umask 077

if [[ -n $tofu_chdir ]]; then
  tofu -chdir="$tofu_chdir" show -json "$plan" >"$json"
else
  tofu show -json "$plan" >"$json"
fi
python3 "$repo_root/infrastructure/policy/inspect-plan.py" "$json" "$@"
