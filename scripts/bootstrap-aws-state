#!/usr/bin/env bash
set -euo pipefail
umask 077

[[ ${AWS_FOUNDATION_BOOTSTRAP_CONFIRMED:-} == create-and-migrate-reviewed-aws-foundation ]]
: "${TF_BACKEND_BUCKET:?TF_BACKEND_BUCKET is required}"
: "${TF_VAR_aws_region:?TF_VAR_aws_region is required}"
: "${TF_VAR_recovery_bucket_region:?TF_VAR_recovery_bucket_region is required}"
: "${TF_VAR_state_bucket_name:?TF_VAR_state_bucket_name is required}"
[[ $TF_BACKEND_BUCKET == "$TF_VAR_state_bucket_name" ]]
: "${TF_VAR_recovery_bucket_name:?TF_VAR_recovery_bucket_name is required}"
: "${TF_VAR_github_owner:?TF_VAR_github_owner is required}"
: "${TF_VAR_github_repository:?TF_VAR_github_repository is required}"
adopt_recovery=false
if [[ ${AWS_FOUNDATION_RECOVERY_ADOPTION_CONFIRMED:-} == import-existing-recovery-bucket ]]; then
  adopt_recovery=true
fi
for command in git jq python3 tofu; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done
[[ -z $(git status --porcelain --untracked-files=all) ]]

root=infrastructure/tofu/aws-foundation
workspace=.local/aws-foundation-bootstrap
copy="$workspace/repository"
[[ ! -e $workspace ]]
mkdir -p "$copy/infrastructure/tofu" "$copy/infrastructure/contract"
cp -a "$root" "$copy/infrastructure/tofu/"
cp -a infrastructure/contract/. "$copy/infrastructure/contract/"
find "$copy" -type d -name .terraform -prune -exec rm -rf {} +
rm -f "$copy/infrastructure/tofu/aws-foundation/terraform.tfstate"*

BOOTSTRAP_VERSIONS="$copy/infrastructure/tofu/aws-foundation/versions.tf" python3 - <<'PY'
import os
from pathlib import Path
path = Path(os.environ["BOOTSTRAP_VERSIONS"])
text = path.read_text()
old = '''  backend "s3" {
    key          = "home-lab/aws-foundation/tofu.tfstate"
    encrypt      = true
    use_lockfile = true
  }
'''
new = '''  backend "local" {
    path = "terraform.tfstate"
  }
'''
if text.count(old) != 1:
    raise SystemExit("unexpected aws-foundation backend declaration")
path.write_text(text.replace(old, new))
PY
bootstrap_root="$copy/infrastructure/tofu/aws-foundation"

if [[ $adopt_recovery == true ]]; then
  cat >"$bootstrap_root/import-existing-recovery.tf" <<'EOF'
import {
  to = aws_s3_bucket.recovery
  id = var.recovery_bucket_name
}

import {
  to = aws_s3_bucket_versioning.recovery
  id = var.recovery_bucket_name
}

import {
  to = aws_s3_bucket_server_side_encryption_configuration.recovery
  id = var.recovery_bucket_name
}

import {
  to = aws_s3_bucket_ownership_controls.recovery
  id = var.recovery_bucket_name
}

import {
  to = aws_s3_bucket_public_access_block.recovery
  id = var.recovery_bucket_name
}
EOF
fi

tofu -chdir="$bootstrap_root" init -input=false
rc=0
tofu -chdir="$bootstrap_root" plan -input=false -parallelism=1 -out=bootstrap.tfplan -detailed-exitcode || rc=$?
[[ ${rc:-0} == 2 ]]
tofu -chdir="$bootstrap_root" show -json bootstrap.tfplan >"$workspace/bootstrap-plan.json"
jq -e --argjson adopt_recovery "$adopt_recovery" '
  ([.resource_changes[]? | select(.mode == "managed")]) as $changes |
  [
    "aws_s3_bucket.recovery",
    "aws_s3_bucket_versioning.recovery",
    "aws_s3_bucket_server_side_encryption_configuration.recovery",
    "aws_s3_bucket_ownership_controls.recovery",
    "aws_s3_bucket_public_access_block.recovery"
  ] as $recovery_imports |
  ($changes | length > 0) and
  ($changes | all(
    . as $change |
    ([$change.type] - [
      "aws_kms_key", "aws_kms_alias", "aws_s3_bucket", "aws_s3_bucket_versioning",
      "aws_s3_bucket_server_side_encryption_configuration", "aws_s3_bucket_ownership_controls",
      "aws_s3_bucket_public_access_block", "aws_s3_bucket_lifecycle_configuration",
      "aws_dynamodb_table", "aws_iam_openid_connect_provider", "aws_iam_role",
      "aws_iam_role_policy"
    ] | length == 0) and
    if ($recovery_imports | index($change.address)) != null then
      $adopt_recovery and ($change.change.importing != null) and
      ($change.change.actions == ["no-op"] or $change.change.actions == ["update"])
    else
      $change.change.actions == ["create"]
    end
  ))
' "$workspace/bootstrap-plan.json" >/dev/null
rm "$workspace/bootstrap-plan.json"

tofu -chdir="$bootstrap_root" apply -input=false -parallelism=1 bootstrap.tfplan
[[ -s $bootstrap_root/terraform.tfstate ]]
rm -rf "$root/.terraform"
cp -p "$bootstrap_root/terraform.tfstate" "$root/terraform.tfstate"

tofu -chdir="$root" init -input=false -migrate-state -force-copy \
  -backend-config="bucket=$TF_BACKEND_BUCKET" \
  -backend-config="region=$TF_VAR_aws_region" \
  -backend-config="encrypt=true" \
  -backend-config="use_lockfile=true"
local_identity=$(jq -c '{lineage,serial}' "$bootstrap_root/terraform.tfstate")
remote_identity=$(tofu -chdir="$root" state pull | jq -c '{lineage,serial}')
[[ $local_identity == "$remote_identity" ]]
rm -f "$root/terraform.tfstate" "$root/terraform.tfstate.backup"
rc=0

tofu -chdir="$root" plan -input=false -parallelism=1 -detailed-exitcode || rc=$?
[[ ${rc:-0} == 0 ]]
echo "aws_foundation_bootstrap=migrated_noop retained_sensitive_workspace=$workspace"
