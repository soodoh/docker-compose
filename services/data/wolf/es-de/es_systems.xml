<?xml version="1.0"?>
<!-- Nintendo DS override supplied by the Wolf ES-DE image. -->
<systemList>
    <system>
        <name>nds</name>
        <fullname>Nintendo DS</fullname>
        <path>%ROMPATH%/nds</path>
        <extension>.app .APP .bin .BIN .dsi .DSI .ids .IDS .nds .NDS .7z .7Z .zip .ZIP</extension>
        <command label="melonDS DS">%EMULATOR_RETROARCH% -L %CORE_RETROARCH%/melondsds_libretro.so %ROM%</command>
        <platform>nds</platform>
        <theme>nds</theme>
    </system>
</systemList>
