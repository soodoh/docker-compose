#!/usr/bin/env bash
set -euo pipefail

readonly RELEASE_API="https://api.github.com/repos/melonDS-emu/melonDS/releases/latest"
readonly EMULATOR_DIR="${MELONDS_DIR:-/mnt/games/emulators}"
readonly BINARY_PATH="${EMULATOR_DIR}/melonDS.bin"
readonly PREVIOUS_PATH="${EMULATOR_DIR}/melonDS.bin.previous"
readonly VERSION_PATH="${EMULATOR_DIR}/melonDS.version"
readonly LOCK_PATH="${EMULATOR_DIR}/.melonDS-update.lock"

check_only=false
if [[ "${1:-}" == "--check" ]]; then
  check_only=true
elif [[ -n "${1:-}" ]]; then
  printf 'Usage: %s [--check]\n' "$0" >&2
  exit 2
fi

mkdir -p "$EMULATOR_DIR"
exec 9>"$LOCK_PATH"
if ! flock -n 9; then
  printf '%s melonDS update already running\n' "$(date --iso-8601=seconds)"
  exit 0
fi

release_json=$(curl --fail --silent --show-error --location \
  --retry 3 --retry-all-errors \
  --header 'Accept: application/vnd.github+json' \
  --header 'X-GitHub-Api-Version: 2022-11-28' \
  --user-agent 'docker-compose-melonds-updater' \
  "$RELEASE_API")

mapfile -t release < <(python -c '
import json
import re
import sys

payload = json.load(sys.stdin)
assets = [
    asset
    for asset in payload["assets"]
    if re.fullmatch(r"melonDS-.*-appimage-x86_64\.zip", asset["name"])
]
if len(assets) != 1:
    raise SystemExit(f"expected one x86-64 AppImage asset, found {len(assets)}")
asset = assets[0]
digest = asset.get("digest", "")
if not digest.startswith("sha256:"):
    raise SystemExit("release asset has no SHA-256 digest")
print(payload["tag_name"])
print(asset["browser_download_url"])
print(digest.removeprefix("sha256:"))
' <<<"$release_json")

readonly latest_version="${release[0]}"
readonly download_url="${release[1]}"
readonly expected_digest="${release[2]}"
current_version=$(cat "$VERSION_PATH" 2>/dev/null || true)

if [[ "$current_version" == "$latest_version" && -x "$BINARY_PATH" ]]; then
  printf '%s melonDS %s is already current\n' "$(date --iso-8601=seconds)" "$current_version"
  exit 0
fi

if $check_only; then
  printf '%s melonDS update available: %s -> %s\n' \
    "$(date --iso-8601=seconds)" "${current_version:-unknown}" "$latest_version"
  exit 0
fi

work_dir=$(mktemp --directory "${EMULATOR_DIR}/.melonDS-update.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT
archive_path="${work_dir}/melonDS.zip"
new_binary_path="${work_dir}/melonDS.bin"

curl --fail --silent --show-error --location \
  --retry 3 --retry-all-errors \
  --user-agent 'docker-compose-melonds-updater' \
  "$download_url" \
  --output "$archive_path"
printf '%s  %s\n' "$expected_digest" "$archive_path" | sha256sum --check --status

mapfile -t archive_members < <(unzip -Z1 "$archive_path" | grep -E '^melonDS.*\.AppImage$')
if [[ "${#archive_members[@]}" -ne 1 ]]; then
  printf 'Expected one AppImage in release archive, found %d\n' "${#archive_members[@]}" >&2
  exit 1
fi
unzip -p "$archive_path" "${archive_members[0]}" >"$new_binary_path"
chmod 0755 "$new_binary_path"

if [[ -f "$BINARY_PATH" ]]; then
  cp --reflink=auto --preserve=mode,timestamps "$BINARY_PATH" "$PREVIOUS_PATH"
fi
mv --force "$new_binary_path" "$BINARY_PATH"
printf '%s\n' "$latest_version" >"${work_dir}/melonDS.version"
mv --force "${work_dir}/melonDS.version" "$VERSION_PATH"

printf '%s updated melonDS to %s; previous binary: %s\n' \
  "$(date --iso-8601=seconds)" "$latest_version" "$PREVIOUS_PATH"
