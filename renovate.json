{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep Docker updates isolated and manually reviewed",
      "matchDatasources": [
        "docker"
      ],
      "groupName": null,
      "separateMinorPatch": true,
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Mark the sole stateless Compose deployment canary",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/flaresolverr/flaresolverr"
      ],
      "labels": [
        "dependencies",
        "compose-canary"
      ],
      "minimumReleaseAge": "7 days",
      "pinDigests": true,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/linuxserver/qbittorrent/"
      ],
      "allowedVersions": "/^5\\.[0-9]+\\.[0-9]+$/",
      "enabled": true
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)services/[^/]+\\.ya?ml$/"
    ]
  }
}
