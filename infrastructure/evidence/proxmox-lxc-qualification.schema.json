{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diloreto.com/schemas/proxmox-lxc-qualification-evidence-v1.json",
  "title": "Proxmox LXC provider qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "qualification_tooling_commit",
    "provider",
    "runs",
    "final_proof",
    "protected_identifiers_included"
  ],
  "properties": {
    "version": { "const": 1 },
    "qualification_tooling_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version", "lock_sha256"],
      "properties": {
        "source": { "const": "registry.opentofu.org/bpg/proxmox" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/createRun" },
        { "$ref": "#/$defs/probeProtectedDeleteRun" },
        { "$ref": "#/$defs/verifyProtectedRun" },
        { "$ref": "#/$defs/unprotectRun" },
        { "$ref": "#/$defs/deleteRun" },
        { "$ref": "#/$defs/verifyEmptyRun" }
      ],
      "items": false
    },
    "final_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "run_id", "state", "plan", "api", "volumes", "backend_lock"],
      "properties": {
        "operation": { "const": "verify-empty" },
        "run_id": { "$ref": "#/$defs/runId" },
        "state": { "const": "empty" },
        "plan": { "const": "no-op" },
        "api": { "const": "absent" },
        "volumes": { "const": "absent" },
        "backend_lock": { "const": "absent" }
      }
    },
    "protected_identifiers_included": { "const": false }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "createRun": {
      "type": "object", "additionalProperties": false, "required": ["operation", "run_id"],
      "properties": { "operation": { "const": "create" }, "run_id": { "$ref": "#/$defs/runId" } }
    },
    "probeProtectedDeleteRun": {
      "type": "object", "additionalProperties": false, "required": ["operation", "run_id"],
      "properties": { "operation": { "const": "probe-protected-delete" }, "run_id": { "$ref": "#/$defs/runId" } }
    },
    "verifyProtectedRun": {
      "type": "object", "additionalProperties": false, "required": ["operation", "run_id"],
      "properties": { "operation": { "const": "verify-protected" }, "run_id": { "$ref": "#/$defs/runId" } }
    },
    "unprotectRun": {
      "type": "object", "additionalProperties": false, "required": ["operation", "run_id"],
      "properties": { "operation": { "const": "unprotect" }, "run_id": { "$ref": "#/$defs/runId" } }
    },
    "deleteRun": {
      "type": "object", "additionalProperties": false, "required": ["operation", "run_id"],
      "properties": { "operation": { "const": "delete" }, "run_id": { "$ref": "#/$defs/runId" } }
    },
    "verifyEmptyRun": {
      "type": "object", "additionalProperties": false, "required": ["operation", "run_id"],
      "properties": { "operation": { "const": "verify-empty" }, "run_id": { "$ref": "#/$defs/runId" } }
    }
  }
}
