# Maintainer: Home Lab Recovery <noreply@invalid>
pkgname=gasket-dkms-git
pkgver=r236.5815ee3
pkgrel=3
pkgdesc="Google Gasket DKMS driver with reviewed current-kernel compatibility patches"
arch=(x86_64)
url="https://github.com/google/gasket-driver"
license=(Apache-2.0)
depends=(dkms)
provides=(gasket-dkms)
conflicts=(gasket-dkms)
_commit=5815ee3908a46a415aac616ac7b9aedcb98a504c
source=(
  "$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
  0001-linux-6.13-dma-buf-namespace.patch
  0002-linux-6.0-remove-no-llseek.patch
  0003-linux-7.1-zap-special-vma.patch
  dkms.conf
)
sha256sums=(
  90cb41d10df702ec63b86968e1e7123abef6df1fdef5e7e2138d57618efbffde
  f630246ed21edd6e8dd0503363657ff90050cfd6e8973f3c307a5cc5aff97c52
  140a657b758bbb9ce883c060efca02a44ed87dc3ed85c0712995e0040e7308e8
  38e9f1ffa13f339b0e3fc4ce1d55d68cdc3e36602df0591b7c201af2027dee2e
  248921b36290b8d938fff55b87bca8add4917046345558faa144ade10e7566db
)

prepare() {
  cd "gasket-driver-$_commit"
  patch -Np1 -i "$srcdir/0001-linux-6.13-dma-buf-namespace.patch"
  patch -Np1 -i "$srcdir/0002-linux-6.0-remove-no-llseek.patch"
  patch -Np1 -i "$srcdir/0003-linux-7.1-zap-special-vma.patch"
}

package() {
  local install_root="$pkgdir/usr/src/gasket-$pkgver"
  install -d -m 0755 "$install_root"
  install -m 0644 "gasket-driver-$_commit"/src/{Kconfig,Makefile,TODO,*.c,*.h} "$install_root/"
  sed "s/#MODULE_VERSION#/$pkgver/" dkms.conf >"$install_root/dkms.conf"
  install -Dm0644 "gasket-driver-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
